PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shop_management_prod?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_64_character_string
JWT_EXPIRE=24h
BASE_CURRENCY=USD
SECONDARY_CURRENCY=SOS
DEFAULT_EXCHANGE_RATE=26000
TAX_RATE=0.05
ENABLE_IN_MEMORY_DB=false

